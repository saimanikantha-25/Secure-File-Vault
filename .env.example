# SERVER CONFIGURATION
SERVER_PORT=8080
SPRING_APPLICATION_NAME=secure-file-vault

# DATABASE CONFIGURATION (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=secure_file_vault
DB_USERNAME=root
DB_PASSWORD=your_secure_password_here

# JWT CONFIGURATION
JWT_SECRET=your_super_secret_base64_encoded_key_of_at_least_256_bits_here
JWT_EXPIRATION=86400000

# MAIL CONFIGURATION (SMTP)
MAIL_USERNAME=your_email_address@example.com
MAIL_PASSWORD=your_smtp_app_password

# STORAGE CONFIGURATION
UPLOAD_DIRECTORY=./uploads
