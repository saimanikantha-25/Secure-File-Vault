# SERVER CONFIGURATION
SERVER_PORT=8080
SPRING_APPLICATION_NAME=secure-file-vault

# DATABASE CONFIGURATION (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=secure_file_vault
DB_USERNAME=root
DB_PASSWORD=your_secure_password_here

# JWT CONFIGURATION (JWT_SECRET must be at least 256 bits / 32 characters long)
JWT_SECRET=your_super_secret_key_of_at_least_32_characters
JWT_EXPIRATION=86400000
JWT_ISSUER=SecureFileVault
REFRESH_TOKEN_HMAC_SECRET=refresh_hmac_secret_key_which_is_long_and_secure_32_bytes

# MAIL CONFIGURATION (SMTP)
MAIL_USERNAME=your_email_address@example.com
MAIL_PASSWORD=your_smtp_app_password

# STORAGE CONFIGURATION
UPLOAD_DIRECTORY=./uploads
